# Конфигурация VkAutoLiker
#
# Приоритет: env vars > .env > дефолты в src/settings.py.
# Все переменные — с префиксом VK_. Файл содержит ВСЕ параметры
# со значениями по умолчанию: скопируйте в .env и меняйте только нужное.
# .env в .gitignore; .env.example — документация, лежит в репозитории.

# --- VK API ---
VK_SERVICE_TOKEN=ваш_vk_service_токен
VK_API_VERSION=5.131
VK_BASE_URL=https://api.vk.ru/method

# --- Браузер (Chrome через undetected-chromedriver) ---
VK_PROFILE_PATH=./chrome_profile
VK_HEADLESS=true

# --- Поиск и сбор постов ---
# Источники опрашиваются в приоритетном порядке:
# queries → hashtags → groups → accounts → auto_friends → auto_groups.
# Списки — через запятую.
VK_QUERIES=
VK_USER_ID=0
VK_HASHTAGS=
VK_GROUPS=
VK_ACCOUNTS=
VK_AUTO_FRIENDS=false
VK_AUTO_GROUPS=false
# user_id > 0 обязателен при VK_AUTO_FRIENDS/VK_AUTO_GROUPS=true
VK_MAX_POSTS_PER_QUERY=100
VK_MAX_POSTS_PER_HASHTAG=100
VK_MAX_POSTS_PER_GROUP=100
VK_MAX_POSTS_PER_ACCOUNT=100
VK_MAX_POSTS_PER_FRIEND=100
VK_MAX_FRIENDS_TO_COLLECT=200
# Минимум опрошенных друзей до раннего выхода (разнообразие источников)
VK_MIN_FRIENDS_TO_POLL=20
VK_MAX_GROUPS_TO_COLLECT=200
# Посты старше N дней не собираются
VK_DAYS_BACK=30

# --- Фильтрация (стоп-слова + LLM) ---
# filter_mode:
#   stop_words — жёсткие слова ('!') отсекают пост, мягкие проходят; LLM не участвует;
#   review     — стоп-слова помечают пост, LLM арбитраж только помеченных;
#   llm        — стоп-слова не участвуют, LLM проверяет все посты по темам.
# Для review/llm обязательны ОБА: VK_LLM_MODEL и VK_LLM_API_KEY (иначе ошибка при старте).
VK_FILTER_MODE=stop_words
# Inline-список стоп-слов (через запятую), объединяется со словарём из файла.
# Суффикс '!' = жёсткое слово, без суффикса = мягкое (формат — см. stop_words.txt).
VK_STOP_WORDS=
VK_STOP_WORDS_FILE=stop_words.txt

# --- LLM (litellm, режимы filter_mode: review / llm) ---
VK_LLM_MODEL=
VK_LLM_API_BASE=
VK_LLM_API_KEY=ваш_llm_api_ключ
# Свой системный промпт — заменяет встроенный универсальный промпт арбитра.
VK_LLM_SYSTEM_PROMPT=
# Темы для проверки в llm-режиме (через запятую).
# По умолчанию — 8 встроенных тем (политика, религия, секс, наркотики, оружие,
# крипто, спам, конфликты); в env дефолт передать без потерь нельзя (темы
# сами содержат запятые) — оставьте закомментированным, чтобы использовать встроенные.
#VK_LLM_STOP_TOPICS=политика,религия,наркотики
VK_LLM_TIMEOUT=60
VK_LLM_MAX_TOKENS=1000
# Текст поста обрезается до N символов перед отправкой в LLM
VK_LLM_MAX_TEXT_LENGTH=1000
# false — для корпоративных endpoint'ов с CA, отсутствующим в certifi
VK_LLM_SSL_VERIFY=true

# --- Лимиты и задержки (все задержки рандомизируются) ---
VK_LIKES_PER_SESSION_MIN=20
VK_LIKES_PER_SESSION_MAX=30
VK_SESSIONS_PER_DAY=3
VK_MIN_DELAY_SEC=15
VK_MAX_DELAY_SEC=60
VK_VIEW_DELAY_MIN_SEC=5
VK_VIEW_DELAY_MAX_SEC=15
# Стоп сессии при N капчах подряд на лайках
VK_MAX_CAPTCHA_STREAK=3

# --- Логирование ---
VK_LOG_LEVEL=INFO
VK_LOG_FILE=vk_autoliker.log

# --- SQLite ---
VK_DB_PATH=vk_autoliker.db

# --- Кэш закрытых стен ---
# Закрытая стена не опрашивается N дней
VK_CLOSED_WALL_TTL_DAYS=7

# --- Профиль Chrome ---
# При превышении размера (МБ) чистятся кэши профиля
VK_PROFILE_MAX_SIZE_MB=500